# Copiar como .env y completar con los valores reales.
# El archivo .env NUNCA se sube al repositorio (está en .gitignore).

# --- Django ---
DJANGO_SECRET_KEY=cambiar-por-clave-secreta-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos ---
DB_ENGINE=django.db.backends.mysql
DB_NAME=barberbook
DB_USER=barberbook
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# --- URL pública del frontend (enlaces de recuperación de contraseña) ---
FRONTEND_URL=http://localhost:4200

# --- Correo electrónico ---
# Por defecto el correo se imprime en la consola del servidor
# (docker logs barberbook_api). Para envío real, cambiar EMAIL_BACKEND
# por django.core.mail.backends.smtp.EmailBackend y cargar las credenciales.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@barberbook.local
